# Disable mock mode — use real backend API
VITE_USE_MOCKS=true
# Backend API base URL (used by Vite proxy)
VITE_API_URL=http://localhost:8000
# Адрес Google Apps Script для заявок с лендинга (…/exec). Пусто — форма показывает контакты
# вместо отправки. Развёртывание — apps-script/landing-leads/README.md
VITE_LANDING_LEADS_URL=https://script.google.com/macros/s/AKfycbyj_EbKOVKop1cuSFN9GnuIjbgVEplZPuUG3ztj3_9SQWbaWss0jrfQj9nen9pgWWtNoQ/exec
# Публичный site key Cloudflare Turnstile (капча формы заявки). Секрет к нему — только в свойствах
# скрипта Apps Script, сюда его не класть. Пусто — форма без капчи.
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAGL33TK-Kc7tYb3o
