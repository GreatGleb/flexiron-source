{
  "name": "flexiron-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src/ --max-warnings=0 --cache --cache-location node_modules/.cache/eslint/",
    "lint:fix": "eslint src/ --fix --cache --cache-location node_modules/.cache/eslint/",
    "format": "prettier --write src/ tests/ --cache",
    "format:check": "prettier --check src/ tests/ --cache",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:audit": "vitest run --config vitest.audit.config.ts",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "audit": "npm audit --audit-level=high",
    "dupes": "jscpd src",
    "deadcode": "knip",
    "verify": "npm run typecheck && npm run lint && npm run dupes && npm run format:check && npm run test:unit"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^20.11.6",
    "jscpd": "^5.0.16",
    "knip": "^6.32.2",
    "prettier": "^3.8.3",
    "sass": "^1.99.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^6.3.2",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.2.6"
  }
}
